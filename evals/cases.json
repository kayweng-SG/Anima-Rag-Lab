{
  "version": 1,
  "description": "ANIMA-RAG-Lab regression cases: Red-Light status, intercept, topic relevance.",
  "cases": [
    {
      "id": "hr_normal_green",
      "group": "heart_rate",
      "description": "Normal small-dog HR question → GREEN + HR guidance",
      "request": {
        "question": "小狗正常心率是多少？运动后呼吸有点快，有点担心。",
        "species": "dog",
        "size": "small",
        "heart_rate_bpm": 95,
        "crt_seconds": 1.5,
        "rectal_temp_f": 101.8
      },
      "expect": {
        "red_light_status": "GREEN",
        "intercepted": false,
        "min_sources": 1,
        "answer_zh_must_contain_any": ["心率", "70"],
        "answer_zh_must_not_contain_any": ["立即就医并途中降温"],
        "sources_content_must_match_any": ["heart_rate", "bpm", "70"],
        "max_elapsed_ms": 8000
      }
    },
    {
      "id": "heat_mild_yellow",
      "group": "heat",
      "description": "Mild heat question (alert, can walk) → YELLOW, not RED",
