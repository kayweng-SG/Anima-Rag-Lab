OPENAI_API_KEY=
ANIMA_LLM_MODEL=gpt-4o-mini

# Semantic retrieval (recommended). Fallback: MERCK_EMBEDDER=tfidf
MERCK_EMBEDDER=sentence_transformers
MERCK_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Prefer merged A+B+C index when present (scripts/13_embed_module_bc.py).
# ANIMA_VECTOR_STORE_DIR=data/processed/merged_vector_store

# App integration. When set, /v1/triage/* and /triage/* require X-API-Key
# (or Authorization: Bearer). Leave empty for open local demo UI.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# ANIMA_API_KEY=
# ANIMA_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:3000

# Optional Redis semantic cache (WBS 4.1). Leave empty to disable.
# With Compose: docker compose --profile cache up --build
# then REDIS_URL=redis://127.0.0.1:6379/0  (or redis://redis:6379/0 inside Compose network)
# No Docker: REDIS_URL=memory://local  (in-process TTL; same API path)
# Or: ./scripts/run_with_cache.sh
# REDIS_URL=

# Optional overrides
# ANIMA_API_HOST=127.0.0.1
# ANIMA_API_PORT=8000
# ANIMA_TRIAGE_DB=data/triage_results.db

# Optional Supabase cloud upsert (Path B). See docs/SUPABASE_MERGE.md
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Lab-local Path A needs no keys: python scripts/16_local_pgvector.py bootstrap

# Retrieval backend for Lab API / RAG (WBS 3.3 / S4)
# local = numpy store; supabase = match_knowledge_chunks RPC; auto = RPC if keys else local
# ANIMA_RETRIEVAL=auto
